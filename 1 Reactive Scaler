fig, axes = plt.subplots(3, 1, figsize=(14, 9), sharex=True)
fig.suptitle("Payment Gateway Workloads — Short Sharp Spikes", fontsize=13, fontweight='bold')
t_ax = np.arange(720) * 5 / 60
